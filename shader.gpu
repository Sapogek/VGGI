

const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal; 
attribute vec2 texCoord;
attribute vec3 tangent;
attribute vec3 bitangent;

uniform mat4 ModelViewMatrix;
uniform mat4 ProjectionMatrix;
uniform mat4 NormalMatrix; 

varying vec3 vNormal;   
varying vec4 vPosition; 
varying vec2 vTexCoord;
varying vec3 vTangent;
varying vec3 vBitangent;

void main() {
    vPosition = ModelViewMatrix * vec4(vertex, 1.0); 
    
    vNormal = normalize(vec3(NormalMatrix * vec4(normal, 0.0)));
    vTangent = normalize(vec3(NormalMatrix * vec4(tangent, 0.0)));
    vBitangent = normalize(vec3(NormalMatrix * vec4(bitangent, 0.0)));
    
    vTexCoord = texCoord;
    
    gl_Position = ProjectionMatrix * vPosition;
}
`;

const fragmentShaderSource = `
precision highp float;

uniform vec4 LightPosition; 
uniform vec4 AmbientColor; 
uniform vec4 DiffuseColor;
uniform vec4 SpecularColor;
uniform float Shininess;   

uniform sampler2D diffuseTexture;
uniform sampler2D specularTexture;
uniform sampler2D normalTexture;

varying vec3 vNormal;
varying vec4 vPosition;
varying vec2 vTexCoord;
varying vec3 vTangent;
varying vec3 vBitangent;

void main() {
    vec4 diffuseColor = texture2D(diffuseTexture, vTexCoord);
    vec4 specularColor = texture2D(specularTexture, vTexCoord);
    vec3 normalMap = texture2D(normalTexture, vTexCoord).rgb;
    
    normalMap = normalMap * 2.0 - 1.0;
    
    mat3 TBN = mat3(
        normalize(vTangent),
        normalize(vBitangent),
        normalize(vNormal)
    );
    
    vec3 N = normalize(TBN * normalMap);
    vec3 L = normalize(vec3(LightPosition - vPosition)); 
    vec3 V = normalize(-vPosition.xyz); 
    
    vec4 ambient = AmbientColor * diffuseColor; 
    
    float NdotL = max(dot(N, L), 0.0);
    vec4 diffuse = DiffuseColor * diffuseColor * NdotL;
    
    vec3 R = reflect(-L, N); 
    float RdotV = max(dot(R, V), 0.0);
    float specFactor = pow(RdotV, Shininess);
    vec4 specular = SpecularColor * specularColor * specFactor;

    gl_FragColor = ambient + diffuse + specular;
}
`;